{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM"],
    "strict": true, "skipLibCheck": true, "noEmit": true, "composite": true, "esModuleInterop": true,
    "types": ["node"], "paths": { "@shared/*": ["./src/shared/*"] }, "baseUrl": "."
  },
  "include": ["electron.vite.config.ts", "src/main/**/*", "src/preload/**/*", "src/shared/**/*"]
}
